{
  "name": "@nogoo9/mcp-server-cloud-fs",
  "mcpName": "io.github.nogoo9/mcp-server-cloud-fs",
  "version": "0.2.0",
  "description": "Drop-in cloud replacement for mcp-server-filesystem \u2014 19 MCP tools (14 baseline + 5 extended) over S3, Azure Blob, and GCS",
  "type": "module",
  "bin": {
    "cloud-fs-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun --minify && chmod +x dist/index.js",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/",
    "test": "bun test src/cache src/providers src/tools src/path-utils.test.ts",
    "test:integration": "bun test src/providers/*.integration.test.ts",
    "test:e2e": "bun test src/server.e2e.test.ts --timeout 30000",
    "test:all": "bun test --timeout 30000",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:setup": "docker compose -f infra/docker-compose.yml up -d",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs"
  },
  "files": [
    "dist/"
  ],
  "license": "PolyForm-Shield-1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nogoo9/mcp-server-cloud-fs"
  },
  "homepage": "https://github.com/nogoo9/mcp-server-cloud-fs#readme",
  "bugs": {
    "url": "https://github.com/nogoo9/mcp-server-cloud-fs/issues"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@azure/storage-blob": "^12.0.0",
    "@google-cloud/storage": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "minimatch": "^9.0.0",
    "zod": "^3.0.0"
  },
  "peerDependencies": {
    "ioredis": ""
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/bun": "latest",
    "typescript": "^5.0.0",
    "ioredis": "^5.0.0"
  }
}
